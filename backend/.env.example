DATABASE_URL=sqlite+aiosqlite:///data/trading_bot.db
ENCRYPTION_KEY=
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true
CORS_ORIGINS=http://localhost:5173

# HTTP Proxy for accessing Binance mainnet (required in China)
# Format: http://host:port or http://user:pass@host:port
# Examples:
#   HTTP_PROXY=http://127.0.0.1:7890
#   HTTP_PROXY=http://user:password@proxy.example.com:8080
HTTP_PROXY=

# 飞书：也可在网页「系统设置」写入数据库（优先级高于下方环境变量）。
# 若机器人开启了「自定义关键词」，将 FEISHU_KEYWORD_PREFIX 设为允许的关键词前缀，每条消息会自动带上。
FEISHU_WEBHOOK_URL=
FEISHU_KEYWORD_PREFIX=[WG]

# 前端访问密码（非空则必须登录后才能用 /api/* 与 /ws/*）
WEB_UI_PASSWORD=
